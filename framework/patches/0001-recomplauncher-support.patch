+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Session-scoped mod selections supplied on the command line by a launcher.
+ *
+ * The runtime already persists player choices in mods/state.toml. A launcher
+ * that owns the game page needs to start the same install with a different
+ * feature set or option value without rewriting that file (which belongs to
+ * the player and to the in-game Mods page). These overrides are resolved over
+ * a copy of the saved selection for the launch, and are never saved back.
+ *
+ * Add them before the first mod runtime commit (main() parses the CLI flags
+ * and calls these before mod_runtime_commit). Unknown package, feature or
+ * option ids fail the launch plan instead of being ignored, so a typo in a
+ * launcher profile is visible. */
+int psx_mod_launcher_override_feature(const char* package_id,
+                                      const char* feature_id, int enabled);
+int psx_mod_launcher_override_option(const char* package_id,
+                                     const char* feature_id,
+                                     const char* option_id, const char* value);
+void psx_mod_launcher_override_clear(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/runtime/include/psx_exit_codes.h b/runtime/include/psx_exit_codes.h
new file mode 100644
index 00000000..b35d0afe
--- /dev/null
+++ b/runtime/include/psx_exit_codes.h
@@ -0,0 +1,26 @@
+#pragma once
+
+/* Stable process exit codes for launchers and wrappers.
+ *
+ * The runtime historically returned 1 for every startup failure, so a launcher
+ * could only say "the game did not start". These codes name the failure class
+ * without changing the meaning of 0 (clean quit) or 1 (unclassified error).
+ * New codes are only added for failures a launcher can act on; anything
+ * ambiguous stays PSX_EXIT_ERROR.
+ *
+ * Keep this list append-only. A launcher ships a mapping for the codes it
+ * knows and shows a generic report for the rest. */
+enum PsxExitCode {
+    PSX_EXIT_OK = 0,
+    PSX_EXIT_ERROR = 1,
+    PSX_EXIT_USAGE = 2,
+    PSX_EXIT_GAME_CONFIG = 3,
+    PSX_EXIT_NO_DISC = 4,
+    PSX_EXIT_DISC_UNREADABLE = 5,
+    PSX_EXIT_WRONG_DISC = 6,
+    PSX_EXIT_SBI_REQUIRED = 7,
+    PSX_EXIT_DISC_MOUNT = 8,
+    PSX_EXIT_BIOS = 9,
+    PSX_EXIT_MOD_PLAN = 10,
+    PSX_EXIT_RENDERER = 11,
+};
