diff --git a/tools/create_release_archive.py b/tools/create_release_archive.py
new file mode 100644
index 00000000..983381b2
--- /dev/null
+++ b/tools/create_release_archive.py
@@ -0,0 +1,82 @@
+#!/usr/bin/env python3
+"""Create a release archive from a staged game directory.
+
+The Windows packager has always written a zip. Linux launchers (and
+RecompLauncher) expect a tar archive, so the packager can hand the same
+staged tree to this script instead. Executable bits are preserved from the
+stage, which is what makes run-flat.sh executable after extraction.
+
+Usage:
+  create_release_archive.py --source dist/stage-game-linux-x64 \
+                            --output dist/mohu-1.0.0-linux-x64.tar.gz
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import sys
+import tarfile
+
+
+MODES = {
+    ".tar": "w",
+    ".tar.gz": "w:gz",
+    ".tgz": "w:gz",
+    ".tar.xz": "w:xz",
+    ".txz": "w:xz",
+}
+
+
+def archive_mode(path: str) -> str:
+    for suffix, mode in MODES.items():
+        if path.endswith(suffix):
+            return mode
+    raise SystemExit(
+        "error: output must end in .tar, .tar.gz/.tgz or .tar.xz/.txz: " + path
+    )
+
+
+def add_tree(tar: tarfile.TarFile, source: str, arcname: str) -> None:
+    info = tar.gettarinfo(source, arcname=arcname)
+    # Keep content ownership out of the archive; extraction maps it to the
+    # player. Permissions (including the executable bit) are preserved.
+    info.uid = 0
+    info.gid = 0
+    info.uname = ""
+    info.gname = ""
+    if info.isdir():
+        tar.addfile(info)
+        for name in sorted(os.listdir(source)):
+            add_tree(tar, os.path.join(source, name), arcname + "/" + name)
+    elif info.isreg():
+        with open(source, "rb") as handle:
+            tar.addfile(info, handle)
+    else:
+        # Symlinks and the like are rare beside a game, but keep them as tar
+        # describes them rather than silently dropping staged content.
+        tar.addfile(info)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--source", required=True)
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+
+    if not os.path.isdir(args.source):
+        print(f"error: source is not a directory: {args.source}", file=sys.stderr)
+        return 1
+
+    mode = archive_mode(args.output)
+    out_dir = os.path.dirname(os.path.abspath(args.output))
+    if out_dir:
+        os.makedirs(out_dir, exist_ok=True)
+    with tarfile.open(args.output, mode) as tar:
+        for name in sorted(os.listdir(args.source)):
+            add_tree(tar, os.path.join(args.source, name), name)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
