+/* Launcher session overrides (mod_launcher_overrides.h). Stored as the
+ * launcher spelled them; validated against the catalog when a commit resolves
+ * a plan, so they never depend on scan order or on main() knowing the ids. */
+namespace {
+struct LauncherFeatureOverride {
+    std::string package_id;
+    std::string feature_id;
+    bool enabled = false;
+};
+struct LauncherOptionOverride {
+    std::string package_id;
+    std::string feature_id;
+    std::string option_id;
+    std::string value;
+};
+std::vector<LauncherFeatureOverride> g_launcher_feature_overrides;
+std::vector<LauncherOptionOverride> g_launcher_option_overrides;
+}  // namespace
+
+extern "C" int psx_mod_launcher_override_feature(const char* package_id,
+                                                 const char* feature_id,
+                                                 int enabled) {
+    if (!package_id || !feature_id || !package_id[0] || !feature_id[0]) return 0;
+    g_launcher_feature_overrides.push_back(
+        {package_id, feature_id, enabled != 0});
+    return 1;
+}
+
+extern "C" int psx_mod_launcher_override_option(const char* package_id,
+                                                const char* feature_id,
+                                                const char* option_id,
+                                                const char* value) {
+    if (!package_id || !feature_id || !option_id || !value ||
+        !package_id[0] || !feature_id[0] || !option_id[0]) return 0;
+    g_launcher_option_overrides.push_back(
+        {package_id, feature_id, option_id, value});
+    return 1;
+}
+
+extern "C" void psx_mod_launcher_override_clear(void) {
+    g_launcher_feature_overrides.clear();
+    g_launcher_option_overrides.clear();
+}
+
+
 namespace PSXRecompV4 {
 namespace {
 thread_local const ModPrepareProgress* active_prepare_progress = nullptr;
 
+bool have_launcher_overrides() {
+    return !::g_launcher_feature_overrides.empty() ||
+           !::g_launcher_option_overrides.empty();
+}
+
+/* Layer the launch-only overrides over a copy of the player's saved
+ * selections. The caller resolves against this copy and restores the
+ * original before install_plan() saves state, so a launcher launch never
+ * rewrites mods/state.toml. */
+bool apply_launcher_overrides(ModPackageManager& selected, std::string* error) {
+    for (const auto& item : ::g_launcher_feature_overrides) {
+        const ModFeature* feature =
+            selected.selected_feature(item.package_id, item.feature_id);
+        if (!feature) {
+            if (error) *error = "launcher override: no feature " +
+                item.package_id + "/" + item.feature_id + " in this build's catalog";
+            return false;
+        }
+        std::string detail;
+        const bool ok = feature->legacy
+            ? selected.set_enabled(item.package_id, item.enabled, &detail)
+            : selected.set_feature_enabled(item.package_id, item.feature_id,
+                                           item.enabled, &detail);
+        if (!ok) {
+            if (error) *error = detail.empty()
+                ? "launcher override: cannot set " + item.package_id + "/" +
+                    item.feature_id
+                : detail;
+            return false;
+        }
+    }
+    for (const auto& item : ::g_launcher_option_overrides) {
+        const ModFeature* feature =
+            selected.selected_feature(item.package_id, item.feature_id);
+        if (!feature) {
+            if (error) *error = "launcher override: no feature " +
+                item.package_id + "/" + item.feature_id + " in this build's catalog";
+            return false;
+        }
+        std::string detail;
+        const bool ok = feature->legacy
+            ? selected.set_option(item.package_id, item.option_id, item.value,
+                                  &detail)
+            : selected.set_feature_option(item.package_id, item.feature_id,
+                                          item.option_id, item.value, &detail);
+        if (!ok) {
+            if (error) *error = detail.empty()
+                ? "launcher override: unsupported option " + item.option_id +
+                    " on " + item.package_id + "/" + item.feature_id
+                : detail;
+            return false;
+        }
+    }
+    return true;
+}
